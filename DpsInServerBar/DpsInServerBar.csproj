<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.8.0</Version>
    <PackageProjectUrl>https://github.com/FunkyJumbo/DPS-In-Server-Bar</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Dev plugins load their icon from images/icon.png next to the dll. -->
  <ItemGroup>
    <Content Include="icon.png" Link="images/icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
